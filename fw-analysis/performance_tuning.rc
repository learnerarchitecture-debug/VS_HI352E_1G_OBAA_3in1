# OBAA Performance Tuning - runs at late_start (after zygote)
# Place in /system/etc/init/obaa_perf.rc

on late_start
    # CPU governor: performance for all cores
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor performance
    write /sys/devices/system/cpu/cpu1/cpufreq/scaling_governor performance
    write /sys/devices/system/cpu/cpu2/cpufreq/scaling_governor performance
    write /sys/devices/system/cpu/cpu3/cpufreq/scaling_governor performance

    # GPU governor (HiSilicon Mali typically at /sys/class/devfreq/gpu)
    write /sys/class/devfreq/gpu/governor performance 2>/dev/null || \
    write /sys/class/devfreq/ff9a0000.gpu/governor performance 2>/dev/null || \
    write /sys/class/devfreq/ffde0000.gpu/governor performance 2>/dev/null || true

    # Disable thermal throttling for GPU (if available)
    write /sys/class/thermal/thermal_zone*/mode disabled 2>/dev/null || true

    # SurfaceFlinger: reduce latency, enable vsync optimization
    setprop debug.sf.enable_hwc_vds 1
    setprop debug.sf.latch_unsignaled 1
    setprop debug.sf.disable_backpressure 1
    setprop debug.sf.early_app_phase_offset_ns 500000
    setprop debug.sf.early_gl_app_phase_offset_ns 500000
    setprop debug.sf.early_gl_phase_offset_ns 500000
    setprop ro.surface_flinger.max_frame_buffer_acquired_buffers 3
    setprop ro.surface_flinger.use_color_management true
    setprop ro.surface_flinger.has_wide_color_display false
    setprop ro.surface_flinger.has_HDR_display false
    setprop ro.surface_flinger.protected_contents true

    # ART runtime: larger heaps, JIT tuning
    setprop dalvik.vm.heapgrowthlimit 192m
    setprop dalvik.vm.heapsize 512m
    setprop dalvik.vm.heaptargetutilization 0.75
    setprop dalvik.vm.heapminfree 512k
    setprop dalvik.vm.heapmaxfree 8m
    setprop dalvik.vm.usejit true
    setprop dalvik.vm.usejitprofiles true
    setprop dalvik.vm.jit.codecachesize 4m

    # Memory management
    setprop ro.config.max_starting_bg 8
    setprop ro.config.max_starting_fg 12
    setprop ro.sys.fw.bg_apps_limit 20
    setprop ro.sys.fw.use_trim_settings true
    setprop ro.config.dha_cached_max 16
    setprop ro.config.dha_empty_max 42
    setprop ro.config.dha_empty_init 32
    setprop ro.config.dha_lru_max 32
    setprop ro.config.dha_pwhitelist_max 16
    setprop ro.config.dha_th_rate 2.3

    # ZRAM (if kernel supports it)
    write /sys/block/zram0/disksize 268435456 2>/dev/null || true
    write /sys/block/zram0/comp_algorithm lz4 2>/dev/null || true
    exec -- /system/bin/mkswap /dev/block/zram0 2>/dev/null || true
    exec -- /system/bin/swapon /dev/block/zram0 -p 32758 2>/dev/null || true

    # Disable unnecessary logging/debug
    setprop log.tag.StatsLogger VERBOSE
    setprop log.tag.GAv4 DEBUG
    setprop persist.log.tag 0

    # Input boost
    setprop ro.config.hw_quickpoweron true
    setprop ro.mot.eri.losalert.delay 1000

    # FSTRIM daily
    exec -- /system/bin/fstrim /data 2>/dev/null || true
    exec -- /system/bin/fstrim /cache 2>/dev/null || true
    exec -- /system/bin/fstrim /system 2>/dev/null || true

    # Disable some Google services that cause background wakeups
    setprop persist.sys.disable_rescue_party true
    setprop persist.sys.force_sw_gles20 0

    # Network buffer tuning
    setprop net.tcp.buffersize.default 4096,87380,524288,4096,16384,110208
    setprop net.tcp.buffersize.wifi 4096,87380,524288,4096,16384,110208
    setprop net.tcp.buffersize.lte 4096,87380,1048576,4096,16384,110208

    # Disable strictmode penalties
    setprop persist.sys.strictmode.disable 1
    setprop persist.sys.strictmode.visual 0