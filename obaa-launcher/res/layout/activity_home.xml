<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="22dp"
        android:paddingBottom="24dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/gutter"
            android:paddingRight="@dimen/gutter">
            <TextView
                android:id="@+id/logo"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/logo_bg"
                android:gravity="center"
                android:text="O"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="@string/brand"
                android:textColor="@color/txt"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:background="@drawable/pill_bg"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="@string/pill"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:letterSpacing="0.06"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format24Hour="HH:mm"
                android:format12Hour="h:mm"
                android:textColor="@color/txt"
                android:textSize="20sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginLeft="@dimen/gutter"
            android:layout_marginRight="@dimen/gutter"
            android:layout_marginTop="14dp"
            android:background="@drawable/hero_bg">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center_vertical"
                android:paddingLeft="30dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE TV · DTV"
                    android:textColor="@color/over_line"
                    android:textSize="10sp"
                    android:letterSpacing="0.35"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/live_tv"
                    style="@style/HeroTitle"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/live_tv_sub"
                    android:textColor="@color/muted"
                    android:textSize="13sp"/>
            </LinearLayout>
            <TextView
                android:id="@+id/watch_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|right"
                android:layout_marginRight="30dp"
                android:background="@drawable/btn_primary"
                android:focusable="true"
                android:clickable="true"
                android:paddingLeft="26dp"
                android:paddingRight="26dp"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:text="@string/watch_now"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"/>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/gutter"
            android:layout_marginTop="16dp"
            android:text="@string/your_apps"
            style="@style/RowLabel"/>

        <HorizontalScrollView
            android:id="@+id/apps_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingLeft="@dimen/gutter"
            android:paddingRight="@dimen/gutter"
            android:clipToPadding="false"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/apps_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/continue_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:visibility="gone"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/gutter"
            android:layout_marginTop="12dp"
            android:text="@string/quick_access"
            style="@style/RowLabel"/>

        <LinearLayout
            android:id="@+id/tools_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/gutter"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"/>
        </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="8dp"
        android:text="@string/hint_bar"
        android:textColor="#6E778A"
        android:textSize="11sp"/>
</FrameLayout>