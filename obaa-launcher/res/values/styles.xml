<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ObaaTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/app_bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="HeroTitle">
        <item name="android:textColor">@color/txt</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="RowLabel">
        <item name="android:textColor">@color/txt</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PinButton">
        <item name="android:layout_width">80dp</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:background">@drawable/btn_pin</item>
        <item name="android:textColor">@color/txt</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="PinDot">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:background">@drawable/pin_dot_empty</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/txt</item>
        <item name="android:textSize">28sp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="FocusButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/style_unselected</item>
        <item name="android:textColor">@color/txt</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_marginEnd">12dp</item>
    </style>

    <style name="FocusButton.Selected" parent="FocusButton">
        <item name="android:background">@drawable/style_selected</item>
    </style>

    <style name="ColorButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:background">@drawable/color_unselected</item>
    </style>

    <style name="ColorButton.Selected" parent="ColorButton">
        <item name="android:background">@drawable/color_selected</item>
    </style>

    <style name="TimerButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:background">@drawable/btn_timer</item>
        <item name="android:textColor">@color/txt</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="BtnPrimary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/txt</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BtnGhost">
