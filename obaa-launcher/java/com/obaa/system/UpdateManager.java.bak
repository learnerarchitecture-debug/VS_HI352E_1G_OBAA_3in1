package com.obaa.system;

import android.app.DownloadManager;
import android.content.Context;
import android.content.Intent;
import android.content.pm.PackageInstaller;
import android.content.pm.PackageManager;
import android.net.Uri;
import android.os.Binder;
import android.os.Build;
import android.os.Environment;
import android.os.IBinder;
import android.util.Log;

import org.json.JSONArray;
import org.json.JSONObject;

import java.io.BufferedInputStream;
import java.io.File;
import java.io.FileOutputStream;
import java.io.InputStream;
import java.net.HttpURLConnection;
import java.net.URL;
import java.security.MessageDigest;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;

public class UpdateManager {
    private static final String TAG = "ObaaUpdateManager";
    private static final String GITHUB_API = "https://api.github.com/repos/";
    private final Context context;
    private final ConfigManager config;
    private final ExecutorService executor = Executors.newSingleThreadExecutor();
    private UpdateCallback callback;

    public interface UpdateCallback {
        void onProgress(int percent);
        void onSuccess(String version);
        void onError(String error);
    }

    public UpdateManager(Context context) {
        this.context = context;
        this.config = new ConfigManager(context);
    }

    public IBinder getBinder() {
        return new Binder() {
            @Override
            protected boolean onTransact(int code, android.os.Parcel data, android.os.Parcel reply, int flags) {
                try {
                    switch (code) {
                        case 1: // checkForUpdates
                            checkForUpdates();
                            reply.writeNoException();
                            return true;
                        case 2: // installLocalPackage
                            installLocalPackage(data.readString());
                            reply.writeNoException();
                            return true;
                        case 3: // downloadAndInstall
                            downloadAndInstall(data.readString());
                            reply.writeNoException();
                            return true;
                        case 4: // getCurrentVersion
                            reply.writeString(getCurrentVersion());
                            return true;
                    }
                } catch (Exception e) {
                    Log.e("ObaaUpdateManager", "Transaction failed", e);
                }
                return super.onTransact(code, data, reply, flags);
            }
        };
    }

    public interface UpdateCallback {
        void onProgress(int percent);
        void onSuccess(String version);
        void onError(String error);
    }

    public UpdateManager(Context context) {
        this.context = context;
        this.config = new ConfigManager(context);
    }

    public void setCallback(UpdateCallback cb) {
        this.callback = cb;
    }

    public void checkForUpdates() {
        executor.execute(() -> {
            try {
                String repo = config.get("update_repo");
                boolean beta = config.getBoolean("beta_channel", false);
                
                String url = GITHUB_API + repo + "/releases" + (beta ? "" : "?per_page=1");
                HttpURLConnection conn = (HttpURLConnection) new URL(url).openConnection();
                conn.setRequestProperty("User-Agent", "OBAA-Launcher/1.1");
                conn.setConnectTimeout(10000);
                conn.setReadTimeout(10000);
                
                if (conn.getResponseCode() != 200) {
                    notifyError("HTTP " + conn.getResponseCode());
                    return;
                }
                
                String json = readStream(conn.getInputStream());
                JSONArray releases = new JSONArray(json);
                if (releases.length() == 0) {
                    notifyError("No releases found");
                    return;
                }
                
                JSONObject latest = releases.getJSONObject(0);
                String version = latest.getString("tag_name").replace("v", "");
                String notes = latest.optString("body", "");
                String apkUrl = null;
                
                JSONArray assets = latest.getJSONArray("assets");
                for (int i = 0; i < assets.length(); i++) {
                    JSONObject asset = assets.getJSONObject(i);
                    String name = asset.getString("name");
                    if (name.endsWith(".apk")) {
                        apkUrl = asset.getString("browser_download_url");
                        break;
                    }
                }
                
                if (apkUrl == null) {
                    notifyError("No APK asset in release");
                    return;
                }
                
                String current = getCurrentVersion();
                if (compareVersions(version, current) <= 0) {
                    notifyError("Already up to date (v" + current + ")");
                    return;
                }
                
                notifySuccess(version, notes, apkUrl);
                
            } catch (Exception e) {
                Log.e(TAG, "Update check failed", e);
                notifyError(e.getMessage());
            }
        });
    }

    public void installLocalPackage(String apkPath) {
        executor.execute(() -> {
            try {
                File file = new File(apkPath);
                if (!file.exists()) {
                    notifyError("APK not found: " + apkPath);
                    return;
                }
                
                PackageInstaller installer = context.getPackageManager().getPackageInstaller();
                PackageInstaller.SessionParams params = new PackageInstaller.SessionParams(
                    PackageInstaller.SessionParams.MODE_FULL_INSTALL);
                params.setAppPackageName("com.obaa.launcher");
                
                int sessionId = installer.createSession(params);
                PackageInstaller.Session session = installer.openSession(sessionId);
                
                try (FileOutputStream out = session.openWrite("base.apk", 0, file.length())) {
                    byte[] buffer = new byte[8192];
                    try (java.io.FileInputStream in = new java.io.FileInputStream(file)) {
                        int len;
                        while ((len = in.read(buffer)) > 0) {
                            out.write(buffer, 0, len);
                        }
                    }
                }
                
                session.fsync(session.openWrite("base.apk", 0, file.length()));
                session.commit(new Intent(context, InstallResultReceiver.class).getIntentSender());
                session.close();
                
                Log.i(TAG, "Install session committed: " + sessionId);
                
            } catch (Exception e) {
                Log.e(TAG, "Local install failed", e);
                notifyError(e.getMessage());
            }
        });
    }

    public void downloadAndInstall(String apkUrl) {
        executor.execute(() -> {
            try {
                File cacheDir = context.getCacheDir();
                File apkFile = new File(cacheDir, "obaa_update_" + System.currentTimeMillis() + ".apk");
                
                DownloadManager dm = (DownloadManager) context.getSystemService(Context.DOWNLOAD_SERVICE);
                DownloadManager.Request req = new DownloadManager.Request(Uri.parse(apkUrl))
                    .setDestinationUri(Uri.fromFile(apkFile))
                    .setTitle("OBAA Update")
                    .setDescription("Downloading v" + getCurrentVersion() + "...")
                    .setNotificationVisibility(DownloadManager.Request.VISIBILITY_VISIBLE_NOTIFY_COMPLETED);
                
                long downloadId = dm.enqueue(req);
                
                // Poll for completion
                boolean done = false;
                while (!done) {
                    try { Thread.sleep(2000); } catch (InterruptedException ignored) {}
                    DownloadManager.Query query = new DownloadManager.Query().setFilterById(downloadId);
                    try (android.database.Cursor c = dm.query(query)) {
                        if (c.moveToFirst()) {
                            int status = c.getInt(c.getColumnIndex(DownloadManager.COLUMN_STATUS));
                            int progress = c.getInt(c.getColumnIndex(DownloadManager.COLUMN_BYTES_DOWNLOADED_SO_FAR));
                            int total = c.getInt(c.getColumnIndex(DownloadManager.COLUMN_TOTAL_SIZE_BYTES));
                            if (total > 0) notifyProgress(progress * 100 / total);
                            if (status == DownloadManager.STATUS_SUCCESSFUL) {
                                done = true;
                            } else if (status == DownloadManager.STATUS_FAILED) {
                                notifyError("Download failed");
                                return;
                            }
                        }
                    }
                }
                
                if (apkFile.exists()) {
                    installLocalPackage(apkFile.getAbsolutePath());
                }
                
            } catch (Exception e) {
                Log.e(TAG, "Download+install failed", e);
                notifyError(e.getMessage());
            }
        });
    }

    private String getCurrentVersion() {
        try {
            return context.getPackageManager().getPackageInfo(context.getPackageName(), 0).versionName;
        } catch (Exception e) {
            return "1.1";
        }
    }

    private int compareVersions(String v1, String v2) {
        String[] a1 = v1.split("\\.");
        String[] a2 = v2.split("\\.");
        int len = Math.max(a1.length, a2.length);
        for (int i = 0; i < len; i++) {
            int n1 = i < a1.length ? Integer.parseInt(a1[i]) : 0;
            int n2 = i < a2.length ? Integer.parseInt(a2[i]) : 0;
            if (n1 != n2) return Integer.compare(n1, n2);
        }
        return 0;
    }

    private String readStream(InputStream is) throws Exception {
        StringBuilder sb = new StringBuilder();
        byte[] buf = new byte[4096];
        int len;
        while ((len = is.read(buf)) > 0) sb.append(new String(buf, 0, len));
        return sb.toString();
    }

    private void notifyProgress(int p) {
        if (callback != null) callback.onProgress(p);
    }
    private void notifySuccess(String version, String notes, String url) {
        if (callback != null) callback.onSuccess(version);
    }
    private void notifyError(String err) {
        if (callback != null) callback.onError(err);
    }
}
